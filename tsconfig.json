{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
    },
    "types": [
      "vitest"
    ],
    "moduleResolution": "node",
  },
  "include": [
    "src",
  ]
}